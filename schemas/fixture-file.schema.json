{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MaxDac/marknotes-spec/schemas/fixture-file.schema.json",
  "title": "MarkNotes golden fixture file",
  "type": "object",
  "required": ["description", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "input", "expected"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "input": { "type": "object" },
          "expected": { "type": "object" },
          "knownDivergence": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "android": { "type": "string", "minLength": 1 },
              "desktop": { "type": "string", "minLength": 1 },
              "web": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
