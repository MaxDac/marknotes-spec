            },
            "hasRecord": false
          }
        ]
      }
    },
    {
      "name": "never synced but the manifest has the same content",
      "input": {
        "local": [
          {
            "path": "a.md",
            "isFolder": false,
            "modifiedMillis": 1000,
            "sha256": "h1"
          }
        ],
        "remote": [
          {
            "path": "a.md",
            "id": "r1",
            "isFolder": false,
            "version": "v1",
            "modifiedMillis": 1000
          }
        ],
        "records": [],
        "manifest": "{\"format\":1,\"app\":\"MarkNotes\",\"deviceId\":\"other\",\"updatedAt\":1,\"files\":{\"a.md\":{\"sha256\":\"h1\",\"version\":\"v1\",\"syncedAt\":1}}}"
      },
      "expected": {
        "actions": [
          {
            "kind": "record",
            "path": "a.md",
            "remote": {
              "path": "a.md",
              "id": "r1",
              "isFolder": false,
              "version": "v1",
              "modifiedMillis": 1000
            },
            "sha256": "h1",
            "updateBase": true
          }
        ]
      }
    },
    {
      "name": "manifest for another version is not used",
      "input": {
        "local": [
          {
            "path": "a.md",
            "isFolder": false,
