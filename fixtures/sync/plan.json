{
  "$schema": "../../schemas/fixture-file.schema.json",
  "description": "The sync plan for one drive (see note-format.md, Sync algorithm). input is a SyncInput: local entries (sha256 for files), remote entries, the records saved at the last sync and the manifest text (or null). expected.actions is the exact ordered list of actions.",
  "cases": [
    {
      "name": "nothing to do",
      "input": {
        "local": [
          {
            "path": "a.md",
            "isFolder": false,
            "modifiedMillis": 1000,
            "sha256": "h1"
          }
        ],
        "remote": [
          {
            "path": "a.md",
            "id": "r1",
            "isFolder": false,
            "version": "v1",
            "modifiedMillis": 1000
          }
        ],
        "records": [
          {
            "path": "a.md",
            "isFolder": false,
            "remoteId": "r1",
            "remoteVersion": "v1",
            "localHash": "h1",
            "syncedAt": 500
          }
        ],
        "manifest": null
      },
      "expected": {
        "actions": []
      }
    },
    {
      "name": "new local note is uploaded",
      "input": {
        "local": [
          {
            "path": "a.md",
            "isFolder": false,
            "modifiedMillis": 1000,
            "sha256": "h1"
          }
        ],
        "remote": [],
        "records": [],
        "manifest": null
      },
      "expected": {
        "actions": [
          {
            "kind": "uploadNew",
            "path": "a.md"
          }
        ]
      }
    },
    {
      "name": "new drive note is downloaded",
      "input": {
        "local": [],
        "remote": [
          {
            "path": "a.md",
            "id": "r1",
            "isFolder": false,
            "version": "v1",
            "modifiedMillis": 1000
          }
        ],
        "records": [],
        "manifest": null
      },
      "expected": {
        "actions": [
          {
            "kind": "download",
            "path": "a.md",
            "remote": {
              "path": "a.md",
              "id": "r1",
              "isFolder": false,
              "version": "v1",
              "modifiedMillis": 1000
            }
          }
        ]
      }
    },
    {
      "name": "local edit is uploaded as a revision",
      "input": {
        "local": [
          {
            "path": "a.md",
            "isFolder": false,
            "modifiedMillis": 1000,
            "sha256": "h2"
          }
        ],
        "remote": [
          {
            "path": "a.md",
            "id": "r1",
            "isFolder": false,
            "version": "v1",
            "modifiedMillis": 1000
          }
        ],
        "records": [
          {
            "path": "a.md",
            "isFolder": false,
            "remoteId": "r1",
            "remoteVersion": "v1",
            "localHash": "h1",
            "syncedAt": 500
          }
        ],
        "manifest": null
      },
      "expected": {
        "actions": [
          {
            "kind": "uploadRevision",
            "path": "a.md",
            "remote": {
              "path": "a.md",
              "id": "r1",
              "isFolder": false,
              "version": "v1",
              "modifiedMillis": 1000
            }
          }
        ]
      }
    },
    {
      "name": "drive edit is downloaded",
      "input": {
        "local": [
          {
            "path": "a.md",
            "isFolder": false,
            "modifiedMillis": 1000,
            "sha256": "h1"
          }
        ],
        "remote": [
          {
            "path": "a.md",
            "id": "r1",
            "isFolder": false,
            "version": "v2",
            "modifiedMillis": 1000
          }
        ],
        "records": [
          {
            "path": "a.md",
            "isFolder": false,
            "remoteId": "r1",
            "remoteVersion": "v1",
            "localHash": "h1",
            "syncedAt": 500
          }
        ],
        "manifest": null
      },
      "expected": {
        "actions": [
          {
            "kind": "download",
            "path": "a.md",
            "remote": {
              "path": "a.md",
              "id": "r1",
              "isFolder": false,
              "version": "v2",
              "modifiedMillis": 1000
            }
          }
        ]
      }
    },
    {
      "name": "drive file replaced with a new id is downloaded",
      "input": {
        "local": [
          {
            "path": "a.md",
            "isFolder": false,
            "modifiedMillis": 1000,
            "sha256": "h1"
          }
        ],
        "remote": [
          {
            "path": "a.md",
