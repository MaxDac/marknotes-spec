            }
          }
        ]
      }
    },
    {
      "name": "edited on both sides is reconciled",
      "input": {
        "local": [
          {
            "path": "a.md",
            "isFolder": false,
            "modifiedMillis": 1000,
            "sha256": "h2"
          }
        ],
        "remote": [
          {
            "path": "a.md",
            "id": "r1",
            "isFolder": false,
            "version": "v2",
            "modifiedMillis": 1000
          }
        ],
        "records": [
          {
            "path": "a.md",
            "isFolder": false,
            "remoteId": "r1",
            "remoteVersion": "v1",
            "localHash": "h1",
            "syncedAt": 500
